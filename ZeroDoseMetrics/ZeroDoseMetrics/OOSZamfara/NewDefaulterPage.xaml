                            </StackLayout>
                            <StackLayout Orientation="Horizontal">
                                <CheckBox x:Name="OPV0_"/>
                                    <Label Text="OPV 0" TextColor="#000000"/>
                            </StackLayout>
                            <StackLayout Orientation="Horizontal">
                                <CheckBox x:Name="HepB0_"/>
                                    <Label Text="Hep B0" TextColor="#000000"/>
                            </StackLayout>
                        </StackLayout>

                        <StackLayout x:Name="atSixToNineWeeks" Orientation="Horizontal" IsVisible="false">
                            <StackLayout>
                                <StackLayout Orientation="Horizontal">
                                    <CheckBox x:Name="PENTA1"/>
                                    <Label Text="PENTA 1" TextColor="#000000"/>
                                </StackLayout>
                                <StackLayout Orientation="Horizontal">
                                    <CheckBox x:Name="PCV1"/>
                                    <Label Text="PCV 1" TextColor="#000000"/>
                                </StackLayout>
                                <StackLayout Orientation="Horizontal">
                                    <CheckBox x:Name="OPV1"/>
                                    <Label Text="OPV 1" TextColor="#000000"/>
                                </StackLayout>
                            </StackLayout>
                            <StackLayout>
                                <StackLayout Orientation="Horizontal">
                                    <CheckBox x:Name="IPV1"/>
                                    <Label Text="IPV 1" TextColor="#000000"/>
                                </StackLayout>
                                <StackLayout Orientation="Horizontal">
                                    <CheckBox x:Name="ROTA1"/>
                                    <Label Text="ROTA 1" TextColor="#000000"/>
                                </StackLayout>
                            </StackLayout>
                        </StackLayout>
                        <StackLayout x:Name="atTenToThirteenWeeks" Orientation="Horizontal" IsVisible="false">
                                <StackLayout Orientation="Horizontal">
                                    <CheckBox x:Name="PENTA2"/>
                                    <Label Text="PENTA 2" TextColor="#000000"/>
                                </StackLayout>
                                <StackLayout Orientation="Horizontal">
                                    <CheckBox x:Name="PCV2"/>
                                    <Label Text="PCV 2" TextColor="#000000"/>
                                </StackLayout>
                                <StackLayout Orientation="Horizontal">
                                    <CheckBox x:Name="OPV2"/>
                                    <Label Text="OPV 2" TextColor="#000000"/>
                                </StackLayout>
                                <StackLayout Orientation="Horizontal">
                                    <CheckBox x:Name="ROTA2"/>
                                    <Label Text="ROTA 2" TextColor="#000000"/>
                                </StackLayout>
                        </StackLayout>
                        <StackLayout x:Name="atfourteenWeeksEightMonths" Orientation="Horizontal" IsVisible="false">
                                <StackLayout>
                                <StackLayout Orientation="Horizontal">
                                    <CheckBox x:Name="PENTA3"/>
                                    <Label Text="PENTA 3" TextColor="#000000"/>
                                </StackLayout>
                                <StackLayout Orientation="Horizontal">
                                    <CheckBox x:Name="PCV3"/>
                                    <Label Text="PCV 3" TextColor="#000000"/>
                                </StackLayout>
                                <StackLayout Orientation="Horizontal">
                                    <CheckBox x:Name="OPV3"/>
                                    <Label Text="OPV 3" TextColor="#000000"/>
                                </StackLayout>
                                </StackLayout>
                                <StackLayout>
                                <StackLayout Orientation="Horizontal">
                                    <CheckBox x:Name="ROTA3"/>
                                    <Label Text="ROTA 3" TextColor="#000000"/>
                                </StackLayout>
                                <StackLayout Orientation="Horizontal">
                                    <CheckBox x:Name="IPV2"/>
                                    <Label Text="IPV 2" TextColor="#000000"/>
                                </StackLayout>
                                </StackLayout>
                        </StackLayout>
                        <StackLayout x:Name="atNineMonthsToElevenMonmths_atTwelveMonthsToFourteenMonths" Orientation="Horizontal" IsVisible="false">
                                <StackLayout Orientation="Horizontal">
                                    <CheckBox x:Name="Measles1"/>
                                    <Label Text="Measles 1" TextColor="#000000"/>
                                </StackLayout>
                                <StackLayout Orientation="Horizontal">
                                    <CheckBox x:Name="YF"/>
                                    <Label Text="Yellow Fever" TextColor="#000000"/>
                                </StackLayout>
                                <StackLayout Orientation="Horizontal">
                                    <CheckBox x:Name="MenA"/>
                                    <Label Text="Men A" TextColor="#000000"/>
                                </StackLayout>
                        </StackLayout>
                    <StackLayout x:Name="atFifteenMonthsToTwentyThreeMonths" Orientation="Horizontal" IsVisible="false">
                                <StackLayout Orientation="Horizontal">
                                    <CheckBox x:Name="Measles2"/>
                                    <Label Text="Measles 2" TextColor="#000000"/>
                                </StackLayout>
                        </StackLayout>

