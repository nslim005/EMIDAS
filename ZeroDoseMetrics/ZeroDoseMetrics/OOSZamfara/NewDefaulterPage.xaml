<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ZeroDoseMetrics.OOSZamfara.NewDefaulterPage" BackgroundColor="#f4f4f4"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">
     <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

         <ScrollView VerticalOptions="StartAndExpand" BackgroundColor="white">

            <StackLayout x:Name="updateInfo" Padding="10" >
            <Label Text="A. Enumeration Information" FontSize="Medium" FontAttributes="Bold" TextColor="#333333"/>

            <Label Text="1. Name of Recorder" TextColor="#000000"/>
            <Entry x:Name="EnumeratorNameEntry"  IsReadOnly="True" FontSize="Default" TextColor="#333333"/>

            <Label Text="2. Mobile Number" TextColor="#000000"/>
            <Entry x:Name="phoneNoEntry" FontSize="Default" IsReadOnly="True" TextColor="#333333"/>

            <Label Text="3. Data Entry Date" TextColor="#000000"/>
            <Entry x:Name="dateEntry" IsReadOnly="True" FontSize="Default" TextColor="#333333"/>

            <Label Text="4. Time" TextColor="#000000"/>
            <Entry x:Name="timeEntry" IsReadOnly="True" FontSize="Default" TextColor="#333333"/>

            <Label Text="5. LGA" TextColor="#000000"/>
            <Entry x:Name="lgaEntry" IsReadOnly="True" TextColor="#333333" FontSize="Default"/>
          
            <Label Text="6. Ward" TextColor="#000000"/>
            <Entry x:Name="wardEntry" IsReadOnly="True" FontSize="Default" TextColor="#333333"/>

            <Label Text="7. Enter Settlement" TextColor="#000000"/><Label Text="*" TextColor="Red" VerticalOptions="Center" FontAttributes="Bold"/>
                <Frame BorderColor="Gray"  
                        CornerRadius="5"  
                        Padding="5"  
                        BackgroundColor="#F8F9FA"  
                        HasShadow="False"><Entry x:Name="settlementEntry" IsReadOnly="False" TextColor="black"/>
                </Frame>
            <Label Text="8. Settlement Type" TextColor="#000000"/><Label Text="*" TextColor="Red" VerticalOptions="Center" FontAttributes="Bold"/>
                <Frame BorderColor="Gray"  
                        CornerRadius="5"  
                        Padding="5"  
                        BackgroundColor="#F8F9FA"
                        HasShadow="False"><Picker x:Name="SettlementTypePicker"
                    Title="Select Settlement Type" FontSize="Small" TextColor="#000000"
                    SelectedIndexChanged="SettlementTypePicker_SelectedIndexChanged"
                    HorizontalOptions="FillAndExpand">
                    <Picker.Items>
                        <x:String>International Border</x:String>
                        <x:String>High Risk</x:String>
                        <x:String>Normadic</x:String>
                        <x:String>Rural</x:String>
                        <x:String>Rural Scattered</x:String>
                        <x:String>Urban</x:String>
                    </Picker.Items>
             </Picker></Frame>

            <Label Text="9. Catchment Area HF" TextColor="#000000"/>
             <Frame BorderColor="Gray"  
                        CornerRadius="5"  
                        Padding="5"  
                        BackgroundColor="#F8F9FA"  
                        HasShadow="False"><Entry x:Name="catchmentAreaHFEntry" IsReadOnly="True" TextColor="Black"/></Frame>

            <Label Text="C. Child Information" TextColor="#000000" FontSize="Medium" FontAttributes="Bold"/>
                
            <Label Text="10. Child's ID" TextColor="#000000"/>
             <Frame BorderColor="Gray"  
                        CornerRadius="5"  
                        Padding="5"  
                        BackgroundColor="#F8F9FA"  
                        HasShadow="False"><Entry x:Name="childIDEnty"  FontSize="Default" IsReadOnly="True" TextColor="black"/></Frame>

            <Label Text="11. Child's Name" TextColor="#000000"/><Label Text="*" TextColor="Red" VerticalOptions="Center" FontAttributes="Bold"/>  
             <Frame BorderColor="Gray"  
                        CornerRadius="5"  
                        Padding="5"  
                        BackgroundColor="#F8F9FA"  
                        HasShadow="False"><Entry x:Name="childNameEnty"  FontSize="Default" IsReadOnly="False" TextColor="black"/></Frame>

            <Label Text="12. Child's Date of Birth" TextColor="#000000"/><Label Text="*" TextColor="Red" VerticalOptions="Center" FontAttributes="Bold"/> 
            <Frame BorderColor="Gray"  
                        CornerRadius="5"  
                        Padding="5"  
                        BackgroundColor="#F8F9FA"  
                        HasShadow="False">
                <DatePicker x:Name="datePicker"
            Format="dd/MM/yyyy"
            HorizontalOptions="Center"
            WidthRequest="250"
            BackgroundColor="White"
            TextColor="Black"
            DateSelected="OnDateSelect" MaximumDate="{x:Static sys:DateTime.Today}" />
            </Frame>

            <Label Text="12. Child's Age Category" TextColor="#000000"/><Label Text="*" TextColor="Red" VerticalOptions="Center" FontAttributes="Bold"/>
            <Frame BorderColor="Gray"  
                        CornerRadius="5"  
                        Padding="5"  
                        BackgroundColor="#F8F9FA"
                        HasShadow="False"><Picker x:Name="AgePicker"
                    Title="Select Child's current Age" FontSize="Small" TextColor="#000000"
                    SelectedIndexChanged="AgePicker_SelectedIndexChanged"
                    HorizontalOptions="FillAndExpand">
                    <Picker.Items>
                        <x:String>Birth - 5 weeks</x:String>
                        <x:String>6 weeks – 9 weeks</x:String>
                        <x:String>10 weeks – 13 weeks</x:String>
                        <x:String>14 weeks – 8 months</x:String>
                        <x:String>9 months – 11 months</x:String>
                        <x:String>12 months – 14 months</x:String>
                        <x:String>15 months – 23 months</x:String>
                    </Picker.Items>
             </Picker></Frame>

             <Label Text="13. Child's Gender" FontSize="Default" TextColor="#000000"/><Label Text="*" TextColor="Red" VerticalOptions="Center" FontAttributes="Bold"/>
             <Frame BorderColor="Gray"  
                        CornerRadius="5"  
                        Padding="5"  
                        BackgroundColor="#F8F9FA"
                        HasShadow="False"><Picker x:Name="GenderPicker"
                    Title="Select Gender" FontSize="Small" TextColor="#000000"
                    SelectedIndexChanged="GenderPicker_SelectedIndexChanged"
                    HorizontalOptions="FillAndExpand">
                    <Picker.Items>
                        <x:String>Male</x:String>
                        <x:String>Female</x:String>
                    </Picker.Items>
             </Picker></Frame>

            <Label Text="14. Caregiver Name" TextColor="#000000"/><Label Text="*" TextColor="Red" VerticalOptions="Center" FontAttributes="Bold"/>  
            <Frame BorderColor="Gray"  
                        CornerRadius="5"  
                        Padding="5"  
                        BackgroundColor="#F8F9FA"
                        HasShadow="False"><Entry x:Name="caregiverNameEnty"  FontSize="Default" TextColor="black" /></Frame>

            <Label Text="15. Caregiver or Community Leader Phone Number" TextColor="#000000"/>
            <Frame BorderColor="Gray"  
                        CornerRadius="5"  
                        Padding="5"  
                        BackgroundColor="#F8F9FA"
                        HasShadow="False"><Entry x:Name="caregiverNumberEnty" FontSize="Default" Keyboard="Numeric" TextColor="black"/></Frame>
           
            <StackLayout x:Name="followupQ" Padding="0" IsVisible="true">

             <Label x:Name="administeredAntigens" TextColor="#000000"
                    Text="16. Select ALL antigens previously Received by Child till date"/><Label Text="*" TextColor="Red" VerticalOptions="Center" FontAttributes="Bold"/>               
                <StackLayout x:Name="CheckBoxGroup">
                        <StackLayout x:Name="atBirth" Orientation="Horizontal" IsVisible="false">
                            <StackLayout Orientation="Horizontal">
                                <CheckBox x:Name="BCG_"/>
