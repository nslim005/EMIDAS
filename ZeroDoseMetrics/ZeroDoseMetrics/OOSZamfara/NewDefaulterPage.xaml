                </StackLayout>
             </StackLayout>
            <StackLayout Padding="20">
                <!--<Button FontSize="Default" Text="Submit" Clicked="Submit_Clicked" />-->

                 <Button
                        Text="Submit"
                        TextColor="White"
                        Clicked="Submit_Clicked"
                        Style="{StaticResource normalButton}"
                        Margin="0,30,0,0" />

            </StackLayout>
        
        </StackLayout>
     </ScrollView>

    </Grid>
