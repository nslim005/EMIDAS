<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ZeroDoseMetrics.OOSZamfara.OOSLandingPage" BackgroundColor="#fffff1">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Image Source="afenetlogo.png"
               WidthRequest="150"
               HeightRequest="50"
               Grid.Row="0" 
               Grid.Column="0" 
               VerticalOptions="Start" 
               HorizontalOptions="Start" />
        
        <ScrollView Grid.Row="1" Grid.ColumnSpan="2">
            <StackLayout x:Name="LoginDetails" Margin="20,0">
                <Label Text="EMIDAS" FontSize="Large" HorizontalTextAlignment="Center" FontAttributes="Bold" TextColor="{StaticResource blueColor}" />
                
                <ActivityIndicator x:Name="activityIndicator" IsRunning="False" IsVisible="False" />
                <Label x:Name="feedbackLabel" Text="" TextColor="{StaticResource blueColor}" HorizontalOptions="Center" />
                
                <Button x:Name="configureBtn"
                        Text="Configure"
                        TextColor="White"
                        Clicked="configureBtn_Clicked"
                        Style="{StaticResource normalButton}"
                        Margin="0,0,0,10" />
                
                <Label Text="* ALL FIELDS ARE REQUIRED" TextColor="Red" />
                
                <Entry x:Name="interviewerNameEntry" Placeholder="Full Name" PlaceholderColor="gray" TextColor="{StaticResource blueColor}" />
                <Entry x:Name="interviewerPhoneNoEntry" Placeholder="Phone Number" PlaceholderColor="gray" TextColor="{StaticResource blueColor}" Keyboard="Numeric" />
                <Picker x:Name="HFPickerLGA" Title="Select LGA" TitleColor="gray" SelectedIndexChanged="HFPickerLGA_SelectedIndexChanged" TextColor="{StaticResource blueColor}" />
                <Picker x:Name="HFPickerWard" Title="Select Ward" TitleColor="gray" SelectedIndexChanged="HFPickerWard_SelectedIndexChanged" TextColor="{StaticResource blueColor}" />
                <Picker x:Name="HFPicker" Title="Select Health Facility" TitleColor="gray" SelectedIndexChanged="HFPicker_SelectedIndexChanged" TextColor="{StaticResource blueColor}" />
                <Picker x:Name="TeamCodePicker" Title="Select Your Team Code" TitleColor="gray" SelectedIndexChanged="TeamCodePicker_SelectedIndexChanged" TextColor="{StaticResource blueColor}" />
                <Picker x:Name="SettlementPicker" Title="Select Settlement" TitleColor="gray" SelectedIndexChanged="SettlementPicker_SelectedIndexChanged" TextColor="{StaticResource blueColor}" />
                
                <Button x:Name="loginButton"
                        Text="Login"
                        TextColor="White"
                        Clicked="loginButton_Clicked"
                        Style="{StaticResource normalButton}"
                        CommandParameter="{Binding .}"
                        Margin="0,30,0,0" />
                <Label x:Name="AppLabel" Text="" FontSize="Small"/>
            </StackLayout>
        </ScrollView>
    </Grid>

</ContentPage>

